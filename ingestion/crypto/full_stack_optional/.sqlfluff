[sqlfluff]
templater = dbt
dialect = postgres
max_line_length = 100
exclude_rules = ST06, RF01, AM04
# RF01 is disabled because sqlfluff cannot resolve dbt ref() targets to real
# column lists, so it produces false positives on every qualified reference.
# AM04 (unknown column count) fails on `select *` from CTEs, which is idiomatic
# in staging models.

[sqlfluff:templater:dbt]
project_dir = ./dbt
profiles_dir = ./dbt
profile = crypto_marts
target = prod

[sqlfluff:indentation]
tab_space_size = 4
indented_joins = false
indented_ctes = false

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent
