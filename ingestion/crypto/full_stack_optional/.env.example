# Copy to .env and adjust. docker-compose reads this file automatically.

# ------------------------------------------------------------------- pipeline
SYMBOLS=["BTCUSDT","ETHUSDT","SOLUSDT","BNBUSDT","XRPUSDT","ADAUSDT"]
INTERVAL=1d
LOOKBACK_DAYS=3

# ------------------------------------------------------------------ warehouse
PG_HOST=postgres
PG_PORT=5432
PG_USER=warehouse
PG_PASSWORD=warehouse
PG_DATABASE=market

# ------------------------------------------------------------------ data lake
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=market-lake

# ---------------------------------------------------------------------- spark
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g

# Binance is geo-restricted in some countries. If /api/v3/klines returns 451,
# switch to the data-only mirror below, which has no such restriction:
# BINANCE_BASE_URL=https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com
BINANCE_REQUESTS_PER_SECOND=8.0
CIRCUIT_BREAKER_THRESHOLD=5

# --------------------------------------------------------------- observability
# Slack-compatible incoming webhook. Leave empty locally: alerts then go to
# structured logs, so the failure callback stays enabled everywhere.
ALERT_WEBHOOK_URL=
ANOMALY_Z_THRESHOLD=3.0
